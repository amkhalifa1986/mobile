# Copy to .env and set your backend address (then run: npx expo start -c)
# Physical phone on same Wi-Fi: use your computer's LAN IP (Windows: ipconfig, Mac: ipconfig getifaddr en0)
EXPO_PUBLIC_API_URL=http://192.168.1.11:5245
# Android emulator: EXPO_PUBLIC_API_URL=http://10.0.2.2:5245
# iOS simulator / web: EXPO_PUBLIC_API_URL=http://localhost:5245
